# Server Configuration
NODE_ENV=development
PORT=4000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=obf_db
DB_USER=postgres
DB_PASSWORD=postgres
TEST_DB_NAME=obf_test_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/obf_db

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRE=30m

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760 # 10MB
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=xlsx,xls,csv

# Rate Limiting
RATE_LIMIT_WINDOW=15 # 15 minutes
RATE_LIMIT_MAX=100 # 100 requests per 15 minutes
RATE_LIMIT_PER_MINUTE=60

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=app.log

# For Docker use
# Use 'db' as the DB_HOST when running in Docker
# DB_HOST=db

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret 